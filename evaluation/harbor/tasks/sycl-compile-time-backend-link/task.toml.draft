# Draft only: rename to task.toml after the pinned 2026.1 image passes Harbor verification.
schema_version = "1.3"
artifacts = ["/app/CMakeLists.txt", "/app/diagnosis.md"]

[metadata]
skill = "uxl-sycl-build-debug"
track = "executable"
category = "compile-time-backend-link"
difficulty = "hard"
origin = "constructed"
source_url = "https://intel.github.io/llvm/design/SYCLNativeCPU.html"
runtime_package = "Intel oneAPI DPC++/C++ Compiler 2026.1.1 Native CPU"

[verifier]
timeout_sec = 300.0

[agent]
timeout_sec = 1200.0

[environment]
workdir = "/app"
network_mode = "public"
build_timeout_sec = 3600.0
os = "linux"
cpus = 2
memory_mb = 8192
